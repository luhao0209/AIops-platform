#!/usr/bin/env bash
set -euo pipefail
umask 077

BUNDLE_VERSION="20260901.1"
BUNDLE_PROFILE="connected-domestic-mirrors"
PAYLOAD_SHA256="24220f06494ca7523bba6d7546dcc5dc301e5d6be42f99aad30b6a7ab7e62ffe"
PAYLOAD_SIZE="537345"
MANIFEST_SHA256="b10fa7fae1e0c158d303140ca12b02b8967c711b811cdae01efe08138b3e6a3a"
PAYLOAD_MARKER='__AIOPS_PAYLOAD_BELOW__'

SELF_PATH="$(cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")"
RUN_DIR="$(dirname -- "${SELF_PATH}")"
INSTALL_DIR="${RUN_DIR}/.aiops-installer/${BUNDLE_VERSION}"
STATE_DIR="${RUN_DIR}/.aiops-installer-state/${BUNDLE_VERSION}"
CONFIG_FILE="${RUN_DIR}/deployment.env"
IMAGE_BUNDLE_DIR="${RUN_DIR}/images"
SSH_ADDRESS_SOURCE='public'
ACTION='deploy'
temporary_dir=''

usage() {
  cat <<EOF
Usage: $(basename -- "$0") [options]

Deploy the four-node AIOps service from one self-extracting package.

Options:
  --config PATH       Protected deployment.env file (default: ./deployment.env)
  --install-dir PATH  Persistent extraction directory
  --state-dir PATH    Persistent runtime-secret/state directory
  --init-config       Create a configuration template and stop
  --check-config      Validate configuration locally without downloading tools
  --preflight-only    Run configuration and read-only four-server checks
  --ssh-private       Connect to the four targets by their configured private IPs
  --extract-only      Verify and extract the package without deploying
  --verify-only       Verify the embedded payload without extracting it
  -h, --help          Show this help

The package never embeds or prints SSH passwords, model keys, or generated
runtime passwords. This ${BUNDLE_PROFILE} bundle uses the project's fixed
domestic mirrors while installing target-side dependencies. If a verified
images/image-bundle.json exists beside this file, the six prebuilt amd64
application images are imported instead of being rebuilt on target nodes.
EOF
}

fail() {
  printf 'installer error: %s\n' "$1" >&2
  exit "${2:-1}"
}

cleanup() {
  local status=$?
  set +e
  case "${temporary_dir}" in
    /tmp/aiops-selfextract.*)
      chmod -R u+rwX "${temporary_dir}" 2>/dev/null || true
      rm -rf -- "${temporary_dir}"
      ;;
    '') ;;
    *) printf 'refusing to clean unexpected temporary path: %s\n' "${temporary_dir}" >&2 ;;
  esac
  exit "${status}"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

sha256_file() {
  local path="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -- "${path}" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 -- "${path}" | awk '{print $1}'
  else
    fail 'sha256sum or shasum is required'
  fi
}

file_size() {
  local path="$1"
  if stat -c %s -- "${path}" >/dev/null 2>&1; then
    stat -c %s -- "${path}"
  else
    stat -f %z -- "${path}"
  fi
}

extract_embedded_archive() {
  local output_path="$1" payload_line actual_size actual_sha
  payload_line="$(awk -v marker="${PAYLOAD_MARKER}" '$0 == marker {print NR + 1; exit}' "${SELF_PATH}")"
  [[ -n "${payload_line}" ]] || fail 'embedded payload marker was not found'
  tail -n +"${payload_line}" -- "${SELF_PATH}" >"${output_path}"
  actual_size="$(file_size "${output_path}")"
  [[ "${actual_size}" == "${PAYLOAD_SIZE}" ]] || fail 'embedded payload size verification failed'
  actual_sha="$(sha256_file "${output_path}")"
  [[ "${actual_sha}" == "${PAYLOAD_SHA256}" ]] || fail 'embedded payload checksum verification failed'
}

validate_archive_members() {
  local archive_path="$1" member
  while IFS= read -r member; do
    case "${member}" in
      payload|payload/*) ;;
      *) fail "unsafe archive member: ${member}" ;;
    esac
    case "/${member}/" in
      */../*|*/./../*) fail "unsafe archive path traversal: ${member}" ;;
    esac
  done < <(tar -tzf "${archive_path}")
}

canonical_parent_path() {
  local requested="$1" parent base
  parent="$(dirname -- "${requested}")"
  base="$(basename -- "${requested}")"
  mkdir -p -- "${parent}"
  parent="$(cd -- "${parent}" && pwd -P)"
  printf '%s/%s\n' "${parent}" "${base}"
}

install_payload() {
  local archive_path="$1" manifest_path current_manifest_sha extraction_dir
  INSTALL_DIR="$(canonical_parent_path "${INSTALL_DIR}")"
  manifest_path="${INSTALL_DIR}/payload/bundle-manifest.json"
  if [[ -f "${manifest_path}" ]]; then
    current_manifest_sha="$(sha256_file "${manifest_path}")"
    [[ "${current_manifest_sha}" == "${MANIFEST_SHA256}" ]] || \
      fail "install directory contains a different bundle: ${INSTALL_DIR}"
    return
  fi
  [[ ! -e "${INSTALL_DIR}" ]] || fail "install path exists but is not this bundle: ${INSTALL_DIR}"
  extraction_dir="${INSTALL_DIR}.extracting.$$"
  [[ ! -e "${extraction_dir}" ]] || fail "temporary extraction path already exists: ${extraction_dir}"
  mkdir -p -- "${extraction_dir}"
  tar -xzf "${archive_path}" -C "${extraction_dir}"
  manifest_path="${extraction_dir}/payload/bundle-manifest.json"
  [[ -f "${manifest_path}" ]] || fail 'bundle manifest is missing after extraction'
  [[ "$(sha256_file "${manifest_path}")" == "${MANIFEST_SHA256}" ]] || \
    fail 'bundle manifest checksum verification failed'
  mv -- "${extraction_dir}" "${INSTALL_DIR}"
}

verify_installed_files() {
  local manifest_path="${INSTALL_DIR}/payload/bundle-manifest.json"
  local project_path="${INSTALL_DIR}/payload/project"
  command -v python3 >/dev/null 2>&1 || fail 'python3 is required to verify installed files'
  python3 - "${manifest_path}" "${project_path}" <<'PY'
from __future__ import annotations

import hashlib
import json
from pathlib import Path, PurePosixPath
import stat
import sys

manifest_path = Path(sys.argv[1])
project_path = Path(sys.argv[2])
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
errors = []
for record in manifest.get("files", []):
    relative = PurePosixPath(str(record.get("path") or ""))
    if not relative.parts or relative.is_absolute() or ".." in relative.parts:
        errors.append(f"unsafe manifest path: {relative}")
        continue
    path = project_path.joinpath(*relative.parts)
    if not path.is_file() or path.is_symlink():
        errors.append(f"missing or unsafe installed file: {relative}")
        continue
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    executable = bool(path.stat().st_mode & stat.S_IXUSR)
    if digest != record.get("sha256"):
        errors.append(f"checksum mismatch: {relative}")
    if path.stat().st_size != int(record.get("size", -1)):
        errors.append(f"size mismatch: {relative}")
    if executable != bool(record.get("executable")):
        errors.append(f"mode mismatch: {relative}")
if errors:
    raise SystemExit("installed payload verification failed: " + "; ".join(errors[:10]))
print(f"Installed payload verification passed: {len(manifest.get('files', []))} files")
PY
}

validate_config_file() {
  local mode numeric_mode
  [[ ! -L "${CONFIG_FILE}" ]] || fail "configuration must not be a symlink: ${CONFIG_FILE}"
  [[ -f "${CONFIG_FILE}" ]] || fail "configuration file does not exist: ${CONFIG_FILE}"
  if stat -c %a -- "${CONFIG_FILE}" >/dev/null 2>&1; then
    mode="$(stat -c %a -- "${CONFIG_FILE}")"
  else
    mode="$(stat -f %Lp -- "${CONFIG_FILE}")"
  fi
  numeric_mode=$((10#${mode}))
  (( numeric_mode % 100 == 0 )) || fail 'configuration must not be readable or writable by group/others; run chmod 600'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)
      [[ $# -ge 2 ]] || fail '--config requires a path' 3
      CONFIG_FILE="$2"
      shift 2
      ;;
    --install-dir)
      [[ $# -ge 2 ]] || fail '--install-dir requires a path' 3
      INSTALL_DIR="$2"
      shift 2
      ;;
    --state-dir)
      [[ $# -ge 2 ]] || fail '--state-dir requires a path' 3
      STATE_DIR="$2"
      shift 2
      ;;
    --init-config) ACTION='init-config'; shift ;;
    --check-config) ACTION='check-config'; shift ;;
    --preflight-only) ACTION='preflight-only'; shift ;;
    --ssh-private) SSH_ADDRESS_SOURCE='private'; shift ;;
    --extract-only) ACTION='extract-only'; shift ;;
    --verify-only) ACTION='verify-only'; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; fail "unknown option: $1" 3 ;;
  esac
done

temporary_dir="$(mktemp -d '/tmp/aiops-selfextract.XXXXXX')"
chmod 700 "${temporary_dir}"
archive_path="${temporary_dir}/payload.tar.gz"
extract_embedded_archive "${archive_path}"
validate_archive_members "${archive_path}"

if [[ "${ACTION}" == 'verify-only' ]]; then
  printf 'Bundle verification passed: version=%s profile=%s payload_sha256=%s\n' \
    "${BUNDLE_VERSION}" "${BUNDLE_PROFILE}" "${PAYLOAD_SHA256}"
  exit 0
fi

install_payload "${archive_path}"
printf 'Bundle extracted and verified at %s\n' "${INSTALL_DIR}"
verify_installed_files

if [[ "${ACTION}" == 'extract-only' ]]; then
  exit 0
fi

template_path="${INSTALL_DIR}/payload/project/deployment/deployment.env.example"
if [[ "${ACTION}" == 'init-config' || ( ! -e "${CONFIG_FILE}" && ! -L "${CONFIG_FILE}" ) ]]; then
  [[ -f "${template_path}" ]] || fail 'embedded configuration template is missing'
  CONFIG_FILE="$(canonical_parent_path "${CONFIG_FILE}")"
  cp -- "${template_path}" "${CONFIG_FILE}"
  chmod 600 "${CONFIG_FILE}"
  printf 'Configuration template created: %s\n' "${CONFIG_FILE}"
  printf '%s\n' 'Fill the four server addresses/passwords, model settings, and CONFIRM_FRESH_SERVERS=YES, then run this installer again.'
  exit 2
fi

CONFIG_FILE="$(canonical_parent_path "${CONFIG_FILE}")"
validate_config_file

project_dir="${INSTALL_DIR}/payload/project"
deploy_script="${project_dir}/deployment/scripts/deploy.sh"
[[ -x "${deploy_script}" ]] || fail 'embedded deployment entrypoint is missing or not executable'

if [[ "${ACTION}" == 'check-config' ]]; then
  DEPLOYMENT_ENV_FILE="${CONFIG_FILE}" "${deploy_script}" --check-config
  exit 0
fi

if [[ "$(uname -s)" != 'Linux' || "$(uname -m)" != 'x86_64' ]]; then
  fail 'deployment and preflight are supported only from a Linux amd64 controller; verification, extraction, and configuration checks are portable'
fi

STATE_DIR="$(canonical_parent_path "${STATE_DIR}")"
mkdir -p -- "${STATE_DIR}"
chmod 700 "${STATE_DIR}"

if [[ "${ACTION}" == 'preflight-only' ]]; then
  printf 'Starting read-only four-server preflight from bundle %s.\n' "${BUNDLE_VERSION}"
  DEPLOYMENT_ENV_FILE="${CONFIG_FILE}" \
  RUNTIME_ENV_FILE="${STATE_DIR}/runtime.env" \
  AIOPS_SSH_ADDRESS_SOURCE="${SSH_ADDRESS_SOURCE}" \
    "${deploy_script}" --preflight-only
  exit 0
fi

printf 'Starting the verified four-node deployment from bundle %s.\n' "${BUNDLE_VERSION}"
if [[ -f "${IMAGE_BUNDLE_DIR}/image-bundle.json" ]]; then
  printf 'Using the verified prebuilt application images at %s.\n' "${IMAGE_BUNDLE_DIR}"
  DEPLOYMENT_ENV_FILE="${CONFIG_FILE}" \
  RUNTIME_ENV_FILE="${STATE_DIR}/runtime.env" \
  AIOPS_IMAGE_BUNDLE_DIR="${IMAGE_BUNDLE_DIR}" \
  AIOPS_SSH_ADDRESS_SOURCE="${SSH_ADDRESS_SOURCE}" \
    "${deploy_script}"
else
  printf '%s\n' 'No external image bundle was found; application images will be built on their target nodes.'
  DEPLOYMENT_ENV_FILE="${CONFIG_FILE}" \
  RUNTIME_ENV_FILE="${STATE_DIR}/runtime.env" \
  AIOPS_SSH_ADDRESS_SOURCE="${SSH_ADDRESS_SOURCE}" \
    "${deploy_script}"
fi

printf '\nInstaller completed successfully.\n'
printf 'Configuration: %s\n' "${CONFIG_FILE}"
printf 'Protected generated runtime state: %s\n' "${STATE_DIR}"
exit 0

__AIOPS_PAYLOAD_BELOW__
