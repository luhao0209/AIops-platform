# Copy this file to ../.secrets/deployment.env, fill every required value,
# then run: chmod 600 ../.secrets/deployment.env
# JSON-style quoted strings are supported and are never evaluated by a shell.

MASTER_PUBLIC_IP=
MASTER_PRIVATE_IP=
MASTER_SSH_USER=root
MASTER_SSH_PORT=22
MASTER_SSH_PASSWORD=

BIZ_PUBLIC_IP=
BIZ_PRIVATE_IP=
BIZ_SSH_USER=root
BIZ_SSH_PORT=22
BIZ_SSH_PASSWORD=

MONITOR_PUBLIC_IP=
MONITOR_PRIVATE_IP=
MONITOR_SSH_USER=root
MONITOR_SSH_PORT=22
MONITOR_SSH_PASSWORD=

AGENT_PUBLIC_IP=
AGENT_PRIVATE_IP=
AGENT_SSH_USER=root
AGENT_SSH_PORT=22
AGENT_SSH_PASSWORD=

# Required safety acknowledgement. The bootstrap does not reset an existing
# cluster, but it is designed only for the four new empty servers.
CONFIRM_FRESH_SERVERS=NO

# Required by render/apply, not by cluster bootstrap.
# MODEL_API_BASE must be an OpenAI-compatible API prefix. Do not use an
# Anthropic endpoint and do not append /chat/completions. For example, the
# regular Zhipu endpoint is https://open.bigmodel.cn/api/paas/v4.
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=

# Optional Web login. The username defaults to admin for compatibility.
AIOPS_ADMIN_USERNAME=admin
# Leave the password empty to generate a strong value in .secrets/runtime.env.
# These two settings only initialize a new runtime.env; later credential
# rotation is deliberately not performed by the deployment script.
AIOPS_ADMIN_PASSWORD=
